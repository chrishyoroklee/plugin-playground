      "params": [
        {
          "id": "rate",
          "label": "Rate",
          "min": 0.05,
          "max": 8,
          "default": 0.6,
          "unit": "Hz",
          "exponent": 2.0
        },
        {
          "id": "depth",
          "label": "Depth",
          "min": 0,
          "max": 8,
          "default": 3,
          "unit": "ms",
          "exponent": 1.0
