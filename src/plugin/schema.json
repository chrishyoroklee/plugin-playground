          "id": "bits",
          "label": "Bits",
          "min": 2,
          "max": 16,
          "default": 8,
          "unit": "bit",
          "exponent": 1.0,
          "integer": true
        }
      ]
    },
    {
      "id": "chorus",
      "label": "Chorus",
      "blurb": "A swept delay line per channel, moving in opposite directions for width. Flanger swaps it for a short comb~ with feedback.",
      "options": [
        {
          "id": "voice",
          "label": "Type",
          "default": "chorus",
          "choices": [
            {
              "id": "chorus",
              "label": "Chorus"
            },
            {
              "id": "flanger",
              "label": "Flanger"
