        {
          "id": "mix",
          "label": "Mix",
          "min": 0,
          "max": 100,
          "default": 50,
          "unit": "%",
          "exponent": 1.0
        }
      ]
    },
    {
      "id": "tremolo",
      "label": "Tremolo",
      "blurb": "An LFO on the volume. Switch to auto-pan to move it between the speakers.",
