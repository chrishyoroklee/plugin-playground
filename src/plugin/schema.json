        {
          "id": "mix",
          "label": "Mix",
          "min": 0,
          "max": 100,
          "default": 30,
          "unit": "%",
          "exponent": 1.0
        }
      ]
    },
    {
      "id": "reverb",
      "label": "Reverb",
      "blurb": "Freeverb's layout: eight comb~ filters into four allpass~ stages per channel, level-matched so a long tail is not a loud one.",
      "options": [],
      "params": [
        {
          "id": "size",
          "label": "Size",
          "min": 0,
          "max": 100,
          "default": 55,
          "unit": "%",
          "exponent": 1.0
