          "id": "depth",
          "label": "Depth",
          "min": 0,
          "max": 100,
          "default": 60,
          "unit": "%",
          "exponent": 1.0
        }
      ]
    },
    {
      "id": "delay",
      "label": "Delay",
      "blurb": "Feedback delay on a tapin~ / tapout~ pair. The time glides when you turn it, like tape. Repeats saturate like tape instead of running away. Ping-pong bounces them left and right.",
      "options": [
        {
          "id": "style",
          "label": "Style",
          "default": "stereo",
          "choices": [
            {
              "id": "stereo",
              "label": "Stereo"
            },
            {
              "id": "pingpong",
              "label": "Ping-pong"
