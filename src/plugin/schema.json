{
  "version": 3,
  "modules": [
    {
      "id": "filter",
      "label": "Filter",
      "blurb": "State-variable filter (svf~). Park it to shape the tone, or sweep the cutoff by hand.",
      "options": [
        {
          "id": "mode",
          "label": "Type",
          "default": "lowpass",
          "choices": [
            {
              "id": "lowpass",
              "label": "Low-pass"
            },
            {
              "id": "highpass",
              "label": "High-pass"
            },
            {
              "id": "bandpass",
              "label": "Band-pass"
            },
            {
              "id": "notch",
              "label": "Notch"
            }
          ]
        }
      ],
      "params": [
        {
          "id": "cutoff",
          "label": "Cutoff",
          "min": 40,
          "max": 10000,
          "default": 1800,
          "unit": "Hz",
          "exponent": 3.0
        },
        {
          "id": "res",
          "label": "Reso",
          "min": 0,
          "max": 100,
          "default": 30,
          "unit": "%",
          "exponent": 1.0
        }
      ]
    },
    {
      "id": "drive",
      "label": "Distortion",
      "blurb": "Five kinds of clipping, a tone control after it, and automatic level matching so more drive means more dirt, not more volume.",
      "options": [
        {
          "id": "character",
          "label": "Type",
          "default": "soft",
          "choices": [
            {
              "id": "soft",
              "label": "Overdrive"
            },
            {
              "id": "tube",
              "label": "Tube"
            },
            {
              "id": "hard",
              "label": "Hard clip"
            },
            {
              "id": "fuzz",
              "label": "Fuzz"
            },
            {
              "id": "fold",
              "label": "Fold"
            }
          ]
        }
      ],
      "params": [
        {
          "id": "amount",
          "label": "Drive",
          "min": 1,
          "max": 10,
          "default": 3,
          "unit": "x",
          "exponent": 1.5
        },
        {
          "id": "tone",
          "label": "Tone",
          "min": 400,
          "max": 10000,
          "default": 8000,
          "unit": "Hz",
          "exponent": 3.0
        }
      ]
    },
    {
      "id": "crush",
      "label": "Crush",
      "blurb": "Bit depth and sample rate reduction with degrade~. Lo-fi on demand.",
      "options": [],
      "params": [
        {
          "id": "rate",
          "label": "Rate",
          "min": 2,
          "max": 100,
          "default": 35,
          "unit": "%",
          "exponent": 2.0
